# ==============================================================================
# GM800 (RK3566) Rockchip 6.1 BSP Optimal Full-Feature Kernel Config Fragment
# Merged on top of rockchip_linux_defconfig via scripts/kconfig/merge_config.sh
# ==============================================================================

# --- Boot / U-Boot 2017.09 Compatibility & Debugging ---
# Disable EFI stub so Image starts with pure ARM64 branch (no manual header patch!)
# CONFIG_EFI is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y

# Enable pstore/ramoops (maps to /reserved-memory/ramoops@110000 for solderless crash logs)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Enable kexec for future hot kernel switching without flashing p8
CONFIG_KEXEC=y
CONFIG_KEXEC_CORE=y
CONFIG_KEXEC_FILE=y

# Rockchip FIQ Debugger on UART2 @ 1500000
CONFIG_FIQ_DEBUGGER=y
CONFIG_FIQ_DEBUGGER_NO_SLEEP=y
CONFIG_FIQ_DEBUGGER_CONSOLE=y
CONFIG_FIQ_DEBUGGER_CONSOLE_DEFAULT_ENABLE=y
CONFIG_FIQ_DEBUGGER_TRUST_ZONE=y

# Pure Linux (remove Android SELinux rtnetlink pollution!)
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_ANDROID is not set
# CONFIG_ANDROID_BINDER_IPC is not set

# Friendly out-of-tree module loading (no strict CRC/sig lock)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set

# --- Discrete Power (No PMIC) & Regulators ---
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=y
CONFIG_ROCKCHIP_IODOMAIN=y

# --- Display (VOP2 + MIPI-DSI 800x1280) & Built-in Backlight ---
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# --- GPU (Open-Source Panfrost for Ubuntu 24.04 Mesa) ---
CONFIG_DRM_PANFROST=m
# Disable conflicting closed-source Mali Bifrost when using Panfrost
# CONFIG_MALI_BIFROST is not set

# --- NPU (RKNPU 0.9.x) + RGA2 2D Acceleration + MPP VPU ---
CONFIG_ROCKCHIP_RKNPU=y
CONFIG_ROCKCHIP_RKNPU_DRM_GEM=y
CONFIG_ROCKCHIP_RKNPU_FENCE=y
CONFIG_ROCKCHIP_RKNPU_DEBUG_FS=y
CONFIG_ROCKCHIP_RKNPU_PROC_FS=y
CONFIG_ROCKCHIP_RGA2=y
CONFIG_ROCKCHIP_RGA_ASYNC=y
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_RKVDEC=y
CONFIG_ROCKCHIP_MPP_RKVDEC2=y
CONFIG_ROCKCHIP_MPP_VDPU2=y
CONFIG_ROCKCHIP_MPP_VEPU2=y
CONFIG_ROCKCHIP_MPP_IEP2=y
CONFIG_ROCKCHIP_MPP_JPGDEC=y

# --- Touchscreen (Mainline Silead + GSL backup modules) ---
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=m
CONFIG_TOUCHSCREEN_GSL3673=m
CONFIG_TOUCHSCREEN_GSL3673_800X1280=m
CONFIG_TOUCHSCREEN_GSLX680_PAD=m

# --- Physical Keys, IR Remote, RTC, LEDs ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ADC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_ROCKCHIP_REMOTECTL=y
CONFIG_ROCKCHIP_REMOTECTL_PWM=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_HYM8563=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# --- Audio (CS4333 dummy-codec Speaker + 4ch PDM Mic Array) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_ROCKCHIP_PDM=y
CONFIG_SND_SOC_ROCKCHIP_PDM_V2=y
CONFIG_SND_SOC_ROCKCHIP_MULTI_DAIS=y
CONFIG_SND_SOC_ROCKCHIP_MULTICODECS=y
CONFIG_SND_SOC_DUMMY_CODEC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SIMPLE_CARD_UTILS=y

# --- Camera (HI-846 8MP + RKISP21) ---
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_ROCKCHIP_ISP_VERSION_V21=y
CONFIG_VIDEO_HI846=m

# --- Networking (RTL8201F RMII Ethernet + AIC8800D80 WiFi6 + BT5) ---
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_REALTEK_PHY=y
CONFIG_RFKILL=y
CONFIG_RFKILL_RK=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WL_ROCKCHIP=y
CONFIG_WLAN_VENDOR_AIC=y
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC8800_SUPPORT=y
CONFIG_AIC8800_SDIO_WLAN=y
CONFIG_AIC8800_SDIO_FW_PATH="/lib/firmware/aic8800_sdio"
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_SERDEV=y

# --- USB Host/OTG, Gadgets, Storage, Filesystems ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_ROCKCHIP=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_F2FS_FS=y
CONFIG_EXFAT_FS=m
CONFIG_VFAT_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y

# --- Full Container (Docker/Podman), WireGuard, nftables, BPF ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SECCOMP=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_TUN=y
CONFIG_WIREGUARD=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
